<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="MainWindow" Title="Hello from XamlForge" Width="640" Height="420" Background="#FFF8FAFC">
  <Grid x:Name="LayoutRoot" Margin="32">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" Text="Your first WPF window" FontSize="28" FontWeight="SemiBold" Foreground="#FF18324C"/>
    <TextBlock x:Name="Description" Grid.Row="1" Text="Select a control to change its properties. Double-click an event to write PowerShell." TextWrapping="Wrap" Foreground="#FF53677B" Margin="0,12,0,24"/>
    <StackPanel x:Name="FormPanel" Grid.Row="2">
      <TextBlock x:Name="NameLabel" Text="Your name" Margin="0,0,0,6"/>
      <TextBox x:Name="NameInput" Text="Nico" FontSize="16" Padding="10"/>
      <Button x:Name="GreetButton" Content="Say hello" HorizontalAlignment="Left" Padding="20,10" Margin="0,16,0,0" Background="#FFE0EDFA"/>
    </StackPanel>
    <TextBlock x:Name="Greeting" Grid.Row="3" Text="Ready when you are." FontSize="16" Foreground="#FF006DB5" Margin="0,24,0,0" TextWrapping="Wrap"/>
  </Grid>
</Window>
